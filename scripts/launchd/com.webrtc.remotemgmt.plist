<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.webrtc.remotemgmt</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/webrtc_remote_mgmt</string>
        <string>--foreground</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/webrtc-remote-mgmt.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/webrtc-remote-mgmt.error.log</string>
</dict>
</plist>
